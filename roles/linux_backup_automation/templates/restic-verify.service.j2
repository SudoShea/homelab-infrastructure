# Licence      : MIT
# ==============================================================================
[Unit]
Description=Restic Backup Weekly Restore Verification Test
Documentation=https://github.com/SudoShea/linux-backup-automation
After=network.target restic-backup.service

[Service]
Type=oneshot
User=root
ExecStart={{ restic_verify_script_path }}
StandardOutput=journal
StandardError=journal
