[Unit]
Description=Restic Automated Encrypted Backup Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ restic_script_path }}
Nice=19
IOSchedulingClass=2
IOSchedulingPriority=7
