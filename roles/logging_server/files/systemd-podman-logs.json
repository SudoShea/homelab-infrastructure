{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Systemd & Podman Logs",
  "tags": ["homelab", "loki", "vector"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki" },
        "definition": "label_values(host)",
        "includeAll": true,
        "multi": true,
        "name": "host",
        "options": [],
        "query": "label_values(host)",
        "refresh": 1,
        "type": "query",
        "label": "Host"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki" },
        "definition": "label_values(container)",
        "includeAll": true,
        "multi": true,
        "name": "container",
        "options": [],
        "query": "label_values(container)",
        "refresh": 1,
        "type": "query",
        "label": "Container/Service"
      },
      {
        "current": { "selected": true, "text": "All", "value": ".*" },
        "name": "level",
        "type": "custom",
        "label": "Severity Level",
        "options": [
          { "selected": true, "text": "All Levels", "value": ".*" },
          { "selected": false, "text": "Errors & Criticals Only", "value": "(?i)(err|error|crit|critical|emerg|emergency|fatal|panic)" },
          { "selected": false, "text": "Warnings & Errors", "value": "(?i)(warn|warning|err|error|crit|critical|emerg|emergency|fatal|panic)" }
        ],
        "query": ".*, (?i)(err|error|crit|critical|emerg|emergency|fatal|panic), (?i)(warn|warning|err|error|crit|critical|emerg|emergency|fatal|panic)"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "name": "search",
        "type": "textbox",
        "label": "Log Search",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Log Lines Volume",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 18, "x": 0, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "editorMode": "code",
          "expr": "sum by (container) (count_over_time({source=\"vector\", host=~\"$host\", container=~\"$container\"} |~ \"$level\" [$__interval]))",
          "legendFormat": "{{container}}",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "id": 2,
      "title": "High Priority Events (Errors/Warnings)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({source=\"vector\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)(err|error|crit|fatal|panic|emerg)\" !~ \"syslogin_perform_logout\" [$__range]))",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "🚨 High Priority Stream (Errors, Fatal, Critical)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "editorMode": "code",
          "expr": "{source=\"vector\", host=~\"$host\", container=~\"$container\"} |~ \"(?i)(err|error|crit|critical|emerg|emergency|fatal|panic)\" !~ \"syslogin_perform_logout\" |~ \"(?i).*$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "title": "📋 All Container & System Logs",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "editorMode": "code",
          "expr": "{source=\"vector\", host=~\"$host\", container=~\"$container\"} |~ \"$level\" |~ \"(?i).*$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
