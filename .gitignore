# ==============================================================================
# Git Ignore    : .gitignore
# Description   : Exclusion patterns for sensitive credentials, keys, and caches
# Author        : SudoShea
# Version       : 1.8.5
# Licence       : MIT
# ==============================================================================

# --- Secrets, Vault Passwords & Keys ---
.vault_pass
.vault-password
vault_pass.txt
*.vault
*.key
*.pem
*.pfx
*.p12

# --- Sensitive Group & Host Variables ---
group_vars/**/vault.yml
host_vars/**/vault.yml
!*.example

# --- Local Environment & Inventory Overrides ---
inventory.local.ini

# --- Backup Artifacts & Snapshots ---
*.tar
*.tar.gz
*.tgz
*.gpg
*.bak
*.tmp

# --- Ansible Execution Artifacts ---
*.retry
ansible.log
.ansible/

# --- Python Bytecode & Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# --- OS & Editor Clutter ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
